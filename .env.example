# Copy to .env and fill in. Never commit the real .env.

# Base URL of the Acumatica instance, no trailing slash.
# Example: https://mycompany.acumatica.com
ACUMATICA_BASE_URL=https://your-instance.acumatica.com

# Contract-based REST endpoint version.
# Default endpoint for Acumatica 2024 R1 (build 24.106.x) is 24.200.001.
# Confirm in your instance under: System > Integration > Web Service Endpoints.
ACUMATICA_ENDPOINT_VERSION=24.200.001

# Credentials for the integration user (session/cookie auth).
ACUMATICA_USERNAME=integration_user
ACUMATICA_PASSWORD=change_me
# Tenant/company login name (the "Company" you pick on the Acumatica login screen).
ACUMATICA_TENANT=MyCompany
# Optional: branch login name. Leave blank for the user's default branch.
ACUMATICA_BRANCH=

# Name of the Generic Inquiry exposed for inventory transaction history.
# Inventory history is NOT a standard Default-endpoint entity, so it is read
# from a Generic Inquiry exposed as an OData endpoint. Create/expose a GI in
# Acumatica (e.g. based on the Inventory Transaction History inquiry IN405000)
# and put its exact name here.
ACUMATICA_INVENTORY_HISTORY_GI=Inventory-Transaction-History

# Host/port for the local dashboard + API server.
APP_HOST=127.0.0.1
APP_PORT=8000
